<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendance Confirmed - <%= tenant.name %></title>
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',system-ui,sans-serif;background:#FAF7FF;color:#1A1A2E;min-height:100vh;display:flex;align-items:center;justify-content:center}
    .card{background:#fff;border-radius:24px;padding:48px;max-width:480px;width:90%;text-align:center;box-shadow:0 12px 48px rgba(26,26,46,.06);border:1.5px solid rgba(232,223,208,.6)}
    .icon{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#22C55E,#16A34A);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:2rem;color:#fff}
    h1{font-size:1.5rem;font-weight:800;margin-bottom:8px}
    p{color:#737373;font-size:.95rem;line-height:1.7;margin-bottom:20px}
    .detail{background:#F9FAFB;border-radius:14px;padding:16px;text-align:left;margin-bottom:24px}
    .detail-row{display:flex;justify-content:space-between;padding:6px 0;font-size:.88rem}
    .detail-row span:first-child{color:#9CA3AF}
    .detail-row span:last-child{font-weight:600;color:#1A1A2E}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 28px;border-radius:12px;font-weight:600;font-size:.9rem;text-decoration:none;transition:all .2s}
    .btn-primary{background:linear-gradient(135deg,#F28C38,#e07b28);color:#fff;box-shadow:0 4px 16px rgba(242,140,56,.25)}
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">&#10003;</div>
    <h1>See you there!</h1>
    <p>Your attendance for your appointment at <strong><%= tenant.name %></strong> is confirmed. We look forward to seeing you!</p>
    <div class="detail">
      <div class="detail-row"><span>Service</span><span><%= booking.service_name %></span></div>
      <div class="detail-row"><span>With</span><span><%= booking.staff_name %></span></div>
      <div class="detail-row"><span>Date</span><span><%= booking.booking_date %></span></div>
      <div class="detail-row"><span>Time</span><span><%= booking.start_time %></span></div>
    </div>
    <a href="/book/<%= tenant.slug %>" class="btn btn-primary">Book Another Appointment</a>
  </div>
</body>
</html>
