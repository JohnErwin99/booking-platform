<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendance Confirmed - <%= tenant.name %></title>
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
  <div class="card">
    <div class="icon">&#10003;</div>
    <h1>See you there!</h1>
    <p>Your attendance for your appointment at <strong><%= tenant.name %></strong> is confirmed. We look forward to seeing you!</p>
    <div class="detail">
      <div class="detail-row"><span>Service</span><span><%= booking.service_name %></span></div>
      <div class="detail-row"><span>With</span><span><%= booking.staff_name %></span></div>
      <div class="detail-row"><span>Date</span><span><%= booking.booking_date %></span></div>
      <div class="detail-row"><span>Time</span><span><%= booking.start_time %></span></div>
    </div>
    <a href="/book/<%= tenant.slug %>" class="btn btn-primary">Book Another Appointment</a>
  </div>
</body>
</html>
