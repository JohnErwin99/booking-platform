<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Join the Bookwize Community — Follow Us, Stay Connected</title>
  <meta name="description" content="Join the Bookwize community on Instagram, TikTok, LinkedIn, and Facebook. Watch tutorials, get tips, and connect with other service business owners across Canada.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://bookwizeapp.com/resources/community">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Join the Bookwize Community">
  <meta property="og:description" content="Follow Bookwize on social media for tutorials, tips, and updates. Connect with other salon owners, barbershops, and service businesses across Canada.">
  <meta property="og:url" content="https://bookwizeapp.com/resources/community">
  <meta property="og:locale" content="en_CA">
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link rel="manifest" href="/manifest.json">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/blog.css">
  <style>
    /* ====== COMMUNITY PAGE ====== */
    .community-hero{padding:72px 24px 48px;text-align:center;max-width:700px;margin:0 auto}
    .community-hero .tag{
      display:inline-block;font-size:.72rem;font-weight:600;color:#F28C38;
      background:rgba(242,140,56,.08);padding:5px 16px;border-radius:100px;
      text-transform:uppercase;letter-spacing:.06em;margin-bottom:16px;
      border:1px solid rgba(242,140,56,.1);
    }
    .community-hero h1{font-size:clamp(1.8rem,4.5vw,2.5rem);font-weight:800;line-height:1.15;letter-spacing:-.03em;margin-bottom:16px}
    .community-hero h1 span{
      background:linear-gradient(135deg,#F28C38,#e07b28);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
    }
    .community-hero p{color:#737373;font-size:1.05rem;line-height:1.7;max-width:560px;margin:0 auto 32px}
    .community-hero p strong{color:#1A1A2E}

    /* Social links row */
    .social-row{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-bottom:12px}
    .social-link{
      display:inline-flex;align-items:center;gap:8px;
      padding:12px 22px;border-radius:14px;font-weight:600;font-size:.88rem;
      text-decoration:none;transition:all .3s cubic-bezier(.4,0,.2,1);
      border:1.5px solid rgba(232,223,208,.5);color:#1A1A2E;background:rgba(255,255,255,.7);
      backdrop-filter:blur(8px);
    }
    .social-link:hover{border-color:#F28C38;color:#F28C38;transform:translateY(-2px);box-shadow:0 6px 20px rgba(242,140,56,.12)}
    .social-link svg{width:20px;height:20px;flex-shrink:0}

    /* Video section */
    .video-section{max-width:960px;margin:0 auto;padding:0 24px 80px}
    .video-section-header{text-align:center;margin-bottom:40px}
    .video-section-header h2{font-size:1.5rem;font-weight:800;margin-bottom:8px}
    .video-section-header p{color:#737373;font-size:.95rem}

    .video-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}

    .video-card{
      background:rgba(255,255,255,.8);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
      border-radius:22px;padding:20px;
      border:1px solid rgba(232,223,208,.4);
      transition:all .35s cubic-bezier(.4,0,.2,1);
    }
    .video-card:hover{box-shadow:0 12px 40px rgba(26,26,46,.06);border-color:rgba(242,140,56,.2)}
    .video-card h3{font-size:.95rem;font-weight:700;margin-bottom:4px;color:#1A1A2E}
    .video-card p{font-size:.82rem;color:#737373;margin-bottom:14px}
    .video-wrapper{
      position:relative;padding-bottom:177.78%;height:0;overflow:hidden;
      border-radius:14px;background:#1A1A2E;
    }
    .video-wrapper video{
      position:absolute;top:0;left:0;width:100%;height:100%;border:0;border-radius:14px;
      object-fit:cover;background:#1A1A2E;
    }

    /* Plea / CTA section */
    .community-plea{
      max-width:760px;margin:0 auto 60px;padding:0 24px;
    }
    .plea-box{
      background:linear-gradient(135deg,#1A1A2E,#2A2A44);border-radius:24px;
      padding:48px;text-align:center;position:relative;overflow:hidden;
    }
    .plea-box::before{
      content:'';position:absolute;width:400px;height:400px;
      background:radial-gradient(circle,rgba(242,140,56,.1),transparent 70%);
      top:-200px;left:-100px;border-radius:50%;
    }
    .plea-box::after{
      content:'';position:absolute;width:300px;height:300px;
      background:radial-gradient(circle,rgba(242,140,56,.06),transparent 70%);
      bottom:-150px;right:-50px;border-radius:50%;
    }
    .plea-box h2{color:#fff;font-size:1.4rem;font-weight:800;margin-bottom:10px;position:relative}
    .plea-box p{color:rgba(255,255,255,.55);font-size:.95rem;line-height:1.7;max-width:480px;margin:0 auto 24px;position:relative}
    .plea-box .social-row{margin-bottom:0}
    .plea-box .social-link{
      background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.12);color:#fff;
    }
    .plea-box .social-link:hover{border-color:#F28C38;color:#F28C38;background:rgba(242,140,56,.08)}

    @media(max-width:800px){
      .video-grid{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:600px){
      .community-hero{padding:56px 16px 36px}
      .community-hero h1{font-size:1.6rem}
      .video-section{padding:0 16px 60px}
      .video-grid{grid-template-columns:1fr;max-width:320px;margin:0 auto}
      .video-card{padding:16px}
      .plea-box{padding:32px 24px;border-radius:20px}
      .social-link{padding:10px 16px;font-size:.82rem}
    }
  </style>
</head>
<body>
  <nav class="blog-nav">
    <div class="blog-nav-inner">
      <a href="/" class="brand"><img src="/img/logo.svg" alt="Bookwize"> Bookwize</a>
