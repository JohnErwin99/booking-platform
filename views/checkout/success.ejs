<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Successful — Bookwize</title>
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
  <div class="card">
    <div class="icon">&#10003;</div>
    <% if (plan) { %>
      <div class="plan-name"><%= plan.charAt(0).toUpperCase() + plan.slice(1) %> Plan</div>
    <% } %>
    <h1>Payment Successful!</h1>
    <p>Thank you for choosing Bookwize. Your account is being set up. You'll receive a confirmation email with your login details shortly.</p>
    <div class="actions">
      <a href="/admin/login" class="btn btn-primary">Go to Dashboard</a>
      <a href="/" class="btn btn-outline">Back to Home</a>
    </div>
  </div>
</body>
</html>
