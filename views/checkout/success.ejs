<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Successful — Bookwize</title>
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',system-ui,sans-serif;background:#FAF7FF;color:#1A1A2E;min-height:100vh;display:flex;align-items:center;justify-content:center}
    .card{background:#fff;border-radius:24px;padding:56px 48px;max-width:520px;width:90%;text-align:center;box-shadow:0 12px 48px rgba(26,26,46,.06);border:1.5px solid rgba(232,223,208,.6)}
    .icon{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#F28C38,#e07b28);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:2rem;color:#fff}
    h1{font-size:1.75rem;font-weight:800;margin-bottom:12px}
    p{color:#737373;font-size:1rem;line-height:1.7;margin-bottom:32px}
    .plan-name{display:inline-block;background:rgba(242,140,56,.08);color:#F28C38;font-weight:700;padding:6px 18px;border-radius:100px;font-size:.85rem;margin-bottom:20px}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 32px;border-radius:12px;font-weight:600;font-size:.95rem;text-decoration:none;transition:all .25s;gap:8px}
    .btn-primary{background:linear-gradient(135deg,#F28C38 0%,#e07b28 100%);color:#fff;box-shadow:0 4px 20px rgba(242,140,56,.3)}
    .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(242,140,56,.35)}
    .btn-outline{border:2px solid rgba(232,223,208,.8);color:#1A1A2E;margin-left:12px}
    .btn-outline:hover{border-color:#F28C38;color:#F28C38}
    .actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12px}
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">&#10003;</div>
    <% if (plan) { %>
      <div class="plan-name"><%= plan.charAt(0).toUpperCase() + plan.slice(1) %> Plan</div>
    <% } %>
    <h1>Payment Successful!</h1>
    <p>Thank you for choosing Bookwize. Your account is being set up. You'll receive a confirmation email with your login details shortly.</p>
    <div class="actions">
      <a href="/admin/login" class="btn btn-primary">Go to Dashboard</a>
      <a href="/" class="btn btn-outline">Back to Home</a>
    </div>
  </div>
</body>
</html>
