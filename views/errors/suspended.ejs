<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Suspended</title>
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #f0f2f5; font-family: sans-serif; }
