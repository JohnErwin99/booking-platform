<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Not Found</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #f0f2f5; }
    .error-page { text-align: center; }
    .error-page h1 { font-size: 4rem; color: #ccc; margin: 0; }
    .error-page p { color: #666; margin: 1rem 0; }
  </style>
</head>
<body>
  <div class="error-page">
    <h1>404</h1>
    <p><%= message || 'Page not found.' %></p>
    <a href="/" class="btn btn-primary">Go Home</a>
  </div>
</body>
</html>
