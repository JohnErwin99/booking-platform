<script>
let currentLang="en";
function toggleLang(){
  currentLang=currentLang==="en"?"fr":"en";
  document.querySelector(".lang-toggle").classList.toggle("fr",currentLang==="fr");
  document.querySelectorAll("[data-en][data-fr]").forEach(function(el){el.innerHTML=el.getAttribute("data-"+currentLang)});
  document.documentElement.lang=currentLang==="fr"?"fr-CA":"en-CA";
}
</script>
