    // Pricing toggle
    let billingMode = 'monthly';
    document.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        billingMode = btn.dataset.billing;
        document.querySelectorAll('.monthly-price').forEach(el => el.style.display = billingMode === 'monthly' ? '' : 'none');
        document.querySelectorAll('.onetime-price').forEach(el => el.style.display = billingMode === 'onetime' ? '' : 'none');
      });
    });

    // Stripe checkout
    document.querySelectorAll('.btn-checkout').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const plan = billingMode === 'monthly' ? btn.dataset.stripeMonthly : btn.dataset.stripeOnetime;
        try {
          btn.textContent = 'Redirecting...';
          btn.style.pointerEvents = 'none';
          const res = await fetch('/api/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ plan })
          });
          const data = await res.json();
          if (data.url) {
            window.location.href = data.url;
          } else {
            alert(data.message || 'Something went wrong. Please try again.');
            btn.textContent = 'Get Started';
            btn.style.pointerEvents = '';
          }
        } catch (err) {
          alert('Connection error. Please try again.');
          btn.textContent = 'Get Started';
          btn.style.pointerEvents = '';
        }
      });
    });
  </script>
