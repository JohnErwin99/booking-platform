  <!-- JSON-LD: FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the best online booking system for salons and barbershops in Canada?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bookwize is an all-in-one online booking and CRM platform built for salons, barbershops, spas, and service businesses across Canada, including Montreal. It features 24/7 online scheduling, staff management, automated email reminders, white-label branding, and embeddable booking widgets. Plans start at $19/month or $299 one-time."
        }
      },
      {
        "@type": "Question",
        "name": "How does online appointment booking work with Bookwize?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Clients visit your branded Bookwize booking page, choose a service and staff member, select an available date and time, and confirm their appointment. You receive an instant notification and the client gets an email confirmation with calendar invite. No app download or account creation is required for clients."
        }
      },
      {
        "@type": "Question",
        "name": "How long does it take to set up Bookwize?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most businesses are live within 5 minutes. Add your services, set your hours, invite your team, and share your booking link. That's it."
        }
      },
      {
        "@type": "Question",
        "name": "Can I customize the look of my booking page?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Bookwize offers full white-label branding. You can set your own colors, logo, fonts, and business name so your booking page looks like it was built just for your business."
        }
      },
      {
        "@type": "Question",
        "name": "Can I embed the booking widget on my website?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Bookwize provides an embed code you can drop into any website. It works on WordPress, Squarespace, Wix, and any custom-built site."
        }
      },
      {
        "@type": "Question",
        "name": "Does Bookwize send appointment reminders?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Bookwize automatically sends email confirmations when a booking is made and reminders 24 hours before the appointment to reduce no-shows. SMS reminders are available on paid plans."
        }
      },
      {
        "@type": "Question",
        "name": "How much does Bookwize cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bookwize starts at $19 CAD/month for the Solo plan or $299 one-time. The Team plan is $39/month or $599 one-time for up to 5 staff. No commission, no hidden fees. A 14-day free trial is available with no credit card required."
        }
      },
      {
        "@type": "Question",
        "name": "Is Bookwize better than Fresha, Booksy, or Vagaro?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bookwize is the only booking platform built for Canadian businesses with French and English support. Unlike Fresha (20% commission on new clients), Bookwize has zero commission. Unlike Booksy and Vagaro, Bookwize offers full white-label branding and one-time payment options starting at $299."
        }
      },
      {
        "@type": "Question",
        "name": "Does Bookwize work in Canada and Quebec?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Bookwize is based in Montreal, Quebec, Canada. It supports CAD, all Canadian timezones, and is fully bilingual (French and English), designed specifically for Canadian service businesses."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use Bookwize without paying commission on bookings?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Absolutely. Bookwize charges a flat monthly fee or one-time payment with zero commission, percentage, or per-booking fee. You keep 100% of your revenue, unlike Fresha which charges 20% on new client bookings."
        }
      }
    ]
  }
  </script>
