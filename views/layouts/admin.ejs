<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css">
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <a href="/admin/dashboard" class="sidebar-logo">
          <img src="/img/logo.svg" alt="Bookwize">
          <span class="sidebar-brand"><%= tenant ? tenant.name : 'Bookwize' %></span>
        </a>
        <button class="sidebar-close" onclick="document.getElementById('sidebar').classList.remove('open')">&times;</button>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="nav-item <%= title === 'Dashboard' ? 'active' : '' %>">
          <span class="nav-icon">&#9632;</span> Dashboard
        </a>
        <a href="/admin/bookings" class="nav-item <%= title === 'Bookings' ? 'active' : '' %>">
          <span class="nav-icon">&#128197;</span> Bookings
        </a>
        <a href="/admin/customers" class="nav-item <%= title === 'Customers' ? 'active' : '' %>">
          <span class="nav-icon">&#128101;</span> Customers
        </a>
        <a href="/admin/services" class="nav-item <%= title === 'Services' ? 'active' : '' %>">
          <span class="nav-icon">&#9986;</span> Services
        </a>
        <a href="/admin/staff" class="nav-item <%= title === 'Staff' ? 'active' : '' %>">
          <span class="nav-icon">&#128100;</span> Staff
        </a>
        <% if (user && (user.role === 'owner' || user.role === 'manager')) { %>
          <a href="/admin/settings" class="nav-item <%= title === 'Settings' ? 'active' : '' %>">
            <span class="nav-icon">&#9881;</span> Settings
          </a>
        <% } %>
        <hr class="nav-divider">
        <a href="/book/<%= user ? (tenant ? tenant.slug : user.tenant_slug) : '#' %>" target="_blank" class="nav-item">
          <span class="nav-icon">&#128279;</span> View Booking Page
        </a>
        <a href="/admin/logout" class="nav-item nav-logout">
          <span class="nav-icon">&#10140;</span> Logout
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <header class="topbar">
        <button class="hamburger" onclick="document.getElementById('sidebar').classList.toggle('open')">&#9776;</button>
        <h1 class="page-title"><%= title %></h1>
        <div class="topbar-right">
          <span class="user-name"><%= user ? user.first_name : '' %></span>
          <span class="user-role badge"><%= user ? user.role : '' %></span>
        </div>
      </header>

      <div class="content-area">
        <%- include('../partials/flash') %>
        <%- body %>
      </div>
    </main>
  </div>

  <script>
    // Close sidebar on mobile when clicking outside
    document.querySelector('.main-content').addEventListener('click', () => {
      document.getElementById('sidebar').classList.remove('open');
    });
  </script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
