<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang === 'fr') ? 'fr-CA' : 'en-CA' %>">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css">
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body>
  <div class="admin-layout">
    <!-- Main Content -->
    <main class="main-content">
      <header class="topbar">
        <h1 class="page-title" id="pageTitle"><%= title %></h1>
        <div class="topbar-right">
          <div class="lang-toggle" onclick="toggleAdminLang()">
            <span class="lang-label lang-en">EN</span>
            <div class="lang-switch"><div class="lang-knob"></div></div>
            <span class="lang-label lang-fr">FR</span>
          </div>
          <span class="user-name"><%= user ? user.first_name : '' %></span>
          <span class="user-role badge"><%= user ? user.role : '' %></span>
        </div>
      </header>

      <% if (typeof trialDaysLeft !== 'undefined') { %>
        <div style="background:<%= trialExpired ? 'rgba(254,226,226,.9)' : 'linear-gradient(135deg,rgba(255,243,230,.85),rgba(254,243,199,.85))' %>;backdrop-filter:blur(8px);padding:14px 22px;border-radius:18px;margin:16px 16px 0;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;border:1px solid <%= trialExpired ? 'rgba(254,202,202,.5)' : 'rgba(242,140,56,.12)' %>">
          <span style="font-size:.85rem;font-weight:600;color:<%= trialExpired ? '#991B1B' : '#92400E' %>">
            <% if (trialExpired) { %>
              <span data-en="Your free trial has expired. Upgrade to keep your bookings active." data-fr="Votre essai gratuit a expiré. Passez à un forfait pour garder vos réservations actives.">Your free trial has expired. Upgrade to keep your bookings active.</span>
            <% } else { %>
              <span data-en="Free trial — <%= trialDaysLeft %> day<%= trialDaysLeft !== 1 ? 's' : '' %> remaining" data-fr="Essai gratuit — <%= trialDaysLeft %> jour<%= trialDaysLeft !== 1 ? 's' : '' %> restant<%= trialDaysLeft !== 1 ? 's' : '' %>">Free trial — <%= trialDaysLeft %> day<%= trialDaysLeft !== 1 ? 's' : '' %> remaining</span>
            <% } %>
          </span>
          <a href="/#pricing" style="font-size:.82rem;font-weight:700;color:#fff;background:linear-gradient(135deg,#F28C38,#e07b28);padding:7px 20px;border-radius:12px;text-decoration:none;box-shadow:0 2px 8px rgba(242,140,56,.2);transition:all .25s" data-en="Upgrade Now" data-fr="Mettre à niveau">Upgrade Now</a>
        </div>
      <% } %>

      <div class="content-area">
        <%- include('../partials/flash') %>
        <%- body %>
      </div>
    </main>
  </div>

  <!-- Bottom Tab Bar -->
  <nav class="tab-bar">
    <a href="/admin/bookings" class="tab-item <%= title === 'Bookings' ? 'active' : '' %>">
      <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span data-en="Calendar" data-fr="Calendrier">Calendar</span>
    </a>
    <a href="/admin/customers" class="tab-item <%= title === 'Customers' ? 'active' : '' %>">
      <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span data-en="Clients" data-fr="Clients">Clients</span>
    </a>
    <% if (user && (user.role === 'owner')) { %>
    <a href="/admin/staff" class="tab-item <%= title === 'Staff' ? 'active' : '' %>">
      <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span data-en="Staff" data-fr="&Eacute;quipe">Staff</span>
    </a>
    <% } %>
    <a href="/admin/menu" class="tab-item <%= title === 'Menu' ? 'active' : '' %>">
      <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <span data-en="Menu" data-fr="Menu">Menu</span>
    </a>
  </nav>

  <script>
    // Admin language toggle
    const pageTitles = {
      'Dashboard': 'Tableau de bord',
      'Bookings': 'Réservations',
      'Customers': 'Clients',
      'Services': 'Services',
      'Staff': 'Personnel',
      'Settings': 'Paramètres',
      'Customer Detail': 'Détails du client',
      'My Services': 'Mes services',
      'All Services': 'Tous les services',
      'My Profile': 'Mon profil',
      'Add Service': 'Ajouter un service',
      'Edit Service': 'Modifier le service',
      'Add Staff': 'Ajouter un membre',
      'Edit Staff': 'Modifier le membre',
      'Menu': 'Menu',
      'Locations': 'Emplacements',
      'Tableau de bord': 'Dashboard',
      'Réservations': 'Bookings',
      'Clients': 'Customers',
      'Personnel': 'Staff',
      'Paramètres': 'Settings',
      'Détails du client': 'Customer Detail',
      'Mes services': 'My Services',
      'Tous les services': 'All Services',
      'Mon profil': 'My Profile',
      'Ajouter un service': 'Add Service',
      'Modifier le service': 'Edit Service',
      'Ajouter un membre': 'Add Staff',
      'Modifier le membre': 'Edit Staff',
      'Emplacements': 'Locations',
    };

    let adminLang = '<%= typeof lang !== "undefined" ? lang : "en" %>';

    function applyAdminLang() {
      document.querySelectorAll('[data-en][data-fr]').forEach(el => {
        if (el.tagName === 'OPTION') el.textContent = el.getAttribute('data-' + adminLang);
        else el.innerHTML = el.getAttribute('data-' + adminLang);
      });
      document.querySelectorAll('[data-en-placeholder][data-fr-placeholder]').forEach(el => {
        el.placeholder = el.getAttribute('data-' + adminLang + '-placeholder');
      });
      const pt = document.getElementById('pageTitle');
      if (pt && pageTitles[pt.textContent.trim()]) {
        pt.textContent = pageTitles[pt.textContent.trim()];
      }
      document.querySelector('.lang-toggle').classList.toggle('fr', adminLang === 'fr');
      document.documentElement.lang = adminLang === 'fr' ? 'fr-CA' : 'en-CA';
    }

    async function toggleAdminLang() {
      adminLang = adminLang === 'en' ? 'fr' : 'en';
      applyAdminLang();
      await fetch('/admin/settings/language', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ language: adminLang })
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (adminLang === 'fr') applyAdminLang();
    });
  </script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
