<div class="form-page">
  <a href="/admin/customers" class="back-link">Back to Customers</a>

  <div class="customer-header">
    <div>
      <h2><%= customer.first_name %> <%= customer.last_name %></h2>
      <p class="text-muted"><%= customer.email %> | <%= customer.phone || 'No phone' %></p>
    </div>
    <div class="customer-stats">
      <div class="mini-stat"><strong><%= customer.total_bookings %></strong> bookings</div>
      <div class="mini-stat"><strong><%= helpers.formatPrice(customer.total_spent_cents) %></strong> spent</div>
      <div class="mini-stat"><strong><%= customer.total_no_shows %></strong> no-shows</div>
    </div>
  </div>

  <% if (customer.tags) { %>
    <div class="tags">
      <% customer.tags.split(',').forEach(tag => { %>
        <span class="tag"><%= tag.trim() %></span>
      <% }) %>
    </div>
  <% } %>

  <% if (customer.preferences) { %>
    <div class="section">
      <h3 class="section-title">Preferences</h3>
      <p><%= customer.preferences %></p>
    </div>
  <% } %>

  <!-- Notes -->
  <div class="section">
    <h3 class="section-title">Notes</h3>
    <form method="POST" action="/admin/customers/<%= customer.id %>/notes" class="note-form">
      <textarea name="note" rows="2" placeholder="Add a note..." required></textarea>
      <button type="submit" class="btn btn-sm btn-primary">Add Note</button>
    </form>
    <% if (notes.length) { %>
      <div class="notes-list">
        <% notes.forEach(n => { %>
          <div class="note-item">
            <p><%= n.note %></p>
            <small class="text-muted">
              <% if (n.staff_first) { %><%= n.staff_first %> <%= n.staff_last %> &mdash; <% } %>
              <%= new Date(n.created_at).toLocaleDateString() %>
            </small>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Booking History -->
  <div class="section">
    <h3 class="section-title">Booking History</h3>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr><th>Date</th><th>Time</th><th>Service</th><th>Staff</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% bookings.forEach(b => { %>
            <tr>
              <td><%= b.booking_date %></td>
              <td><%= helpers.formatTimeLabel(b.start_time) %></td>
              <td><%= b.service_name %></td>
              <td><%= b.staff_name %></td>
              <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
            </tr>
          <% }) %>
          <% if (bookings.length === 0) { %>
            <tr><td colspan="5" class="text-center">No bookings yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
