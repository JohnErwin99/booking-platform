<div class="form-page">
  <a href="/admin/customers" class="back-link" data-en="Back to Customers" data-fr="Retour aux clients">Back to Customers</a>

  <div class="customer-header">
    <div>
      <h2><%= customer.first_name %> <%= customer.last_name %></h2>
      <p class="text-muted"><%= customer.email %> | <%= customer.phone || 'No phone' %></p>
    </div>
    <div class="customer-stats">
      <div class="mini-stat"><strong><%= customer.total_bookings %></strong> <span data-en="bookings" data-fr="réservations">bookings</span></div>
      <div class="mini-stat"><strong><%= helpers.formatPrice(customer.total_spent_cents) %></strong> <span data-en="spent" data-fr="dépensé">spent</span></div>
      <div class="mini-stat"><strong><%= customer.total_no_shows %></strong> <span data-en="no-shows" data-fr="absences">no-shows</span></div>
    </div>
  </div>

  <% if (customer.tags) { %>
    <div class="tags">
      <% customer.tags.split(',').forEach(tag => { %>
        <span class="tag"><%= tag.trim() %></span>
      <% }) %>
    </div>
  <% } %>

  <% if (customer.preferences) { %>
    <div class="section">
      <h3 class="section-title" data-en="Preferences" data-fr="Préférences">Preferences</h3>
      <p><%= customer.preferences %></p>
    </div>
  <% } %>

  <!-- Notes -->
  <div class="section">
    <h3 class="section-title" data-en="Notes" data-fr="Notes">Notes</h3>
    <form method="POST" action="/admin/customers/<%= customer.id %>/notes" class="note-form">
      <textarea name="note" rows="2" placeholder="Add a note..." data-en-placeholder="Add a note..." data-fr-placeholder="Ajouter une note..." required></textarea>
      <button type="submit" class="btn btn-sm btn-primary" data-en="Add Note" data-fr="Ajouter une note">Add Note</button>
    </form>
    <% if (notes.length) { %>
      <div class="notes-list">
        <% notes.forEach(n => { %>
          <div class="note-item">
            <p><%= n.note %></p>
            <small class="text-muted">
              <% if (n.staff_first) { %><%= n.staff_first %> <%= n.staff_last %> &mdash; <% } %>
              <%= new Date(n.created_at).toLocaleDateString() %>
            </small>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Booking History -->
  <div class="section">
    <h3 class="section-title" data-en="Booking History" data-fr="Historique des réservations">Booking History</h3>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th data-en="Date" data-fr="Date">Date</th>
            <th data-en="Time" data-fr="Heure">Time</th>
            <th data-en="Service" data-fr="Service">Service</th>
            <th data-en="Staff" data-fr="Personnel">Staff</th>
            <th data-en="Status" data-fr="Statut">Status</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.forEach(b => { %>
            <tr>
              <td><%= b.booking_date %></td>
              <td><%= helpers.formatTimeLabel(b.start_time) %></td>
              <td><%= b.service_name %></td>
              <td><%= b.staff_name %></td>
              <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
            </tr>
          <% }) %>
          <% if (bookings.length === 0) { %>
            <tr><td colspan="5" class="text-center" data-en="No bookings yet." data-fr="Aucune réservation pour l'instant.">No bookings yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
