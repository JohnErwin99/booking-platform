<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-logo">
        <img src="/img/logo.svg" alt="Bookwize">
        <span>Bookwize</span>
      </div>
      <h2>Create your account</h2>
      <p class="subtitle">Free 14-day trial. No credit card needed.</p>
      <%- include('../partials/flash') %>
      <form method="POST" action="/admin/signup">
        <div class="form-group">
          <label>Business Name</label>
          <input type="text" name="business_name" placeholder="e.g. Faded Studio" required>
        </div>
        <div class="field-row">
          <div class="form-group">
            <label>First Name</label>
            <input type="text" name="first_name" placeholder="John" required>
          </div>
          <div class="form-group">
            <label>Last Name</label>
            <input type="text" name="last_name" placeholder="Smith" required>
          </div>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="you@business.com" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="Min 6 characters" required minlength="6">
        </div>
        <button type="submit" class="btn-signup">Start Free Trial</button>
        <ul class="trial-checklist">
          <li>14 days free</li>
          <li>Online booking page</li>
          <li>Email notifications</li>
          <li>No credit card required</li>
        </ul>
      </form>
      <div class="signup-footer">
        Already have an account? <a href="/admin/login">Log in</a>
      </div>
    </div>
  </div>
</body>
</html>
