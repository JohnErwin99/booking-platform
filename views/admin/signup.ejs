<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <div class="signup-page">
    <!-- Left — Branding -->
    <div class="signup-brand">
      <div class="logo-row">
        <img src="/img/logo.svg" alt="Bookwize">
        <span>Bookwize</span>
      </div>
      <span class="tag">14-day free trial — No credit card required</span>
      <h1>Start booking<br><span class="gradient-text">in 2 minutes.</span></h1>
      <p>Create your free account, set up your services, and share your booking link. It's that simple.</p>
      <div class="trial-perks">
        <h3>Your free trial includes:</h3>
        <ul>
          <li>Online booking page</li>
          <li>1 staff member</li>
          <li>Up to 3 services</li>
          <li>10 bookings per month</li>
          <li>Email notifications</li>
          <li>Customer management</li>
          <li>Full setup wizard</li>
        </ul>
      </div>
    </div>

    <!-- Right — Form -->
    <div class="signup-form-wrap">
      <div class="signup-card">
        <h2>Create your account</h2>
        <p class="subtitle">Free 14-day trial. No credit card needed.</p>
        <%- include('../partials/flash') %>
        <form method="POST" action="/admin/signup">
          <div class="form-group">
            <label>Business Name</label>
            <input type="text" name="business_name" placeholder="e.g. Faded Studio" required>
          </div>
          <div class="field-row">
            <div class="form-group">
              <label>First Name</label>
              <input type="text" name="first_name" placeholder="John" required>
            </div>
            <div class="form-group">
              <label>Last Name</label>
              <input type="text" name="last_name" placeholder="Smith" required>
            </div>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="you@business.com" required>
          </div>
          <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" placeholder="Min 6 characters" required minlength="6">
          </div>
          <button type="submit" class="btn-signup">Start Free Trial</button>
          <p class="trial-note">14 days free. Upgrade anytime. Cancel anytime.</p>
        </form>
        <div class="signup-footer">
          Already have an account? <a href="/admin/login">Log in</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
