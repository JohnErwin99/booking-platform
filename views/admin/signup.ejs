<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',system-ui,-apple-system,sans-serif;min-height:100vh;background:#FAF7FF;color:#1A1A2E;overflow-x:hidden}

    .signup-page{display:grid;grid-template-columns:1fr 1fr;min-height:100vh}

    /* Left — Branding */
    .signup-brand{
      display:flex;flex-direction:column;justify-content:center;padding:64px;
      background:radial-gradient(ellipse at 20% 50%,rgba(242,140,56,.06) 0%,transparent 70%),#FAF7FF;
      position:relative;overflow:hidden;
    }
    .signup-brand::before{
      content:'';position:absolute;inset:0;
      background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23E8DFD0' fill-opacity='0.15'%3E%3Ccircle cx='1' cy='1' r='1'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity:.5;
    }
    .signup-brand > *{position:relative;z-index:1}
    .signup-brand .logo-row{display:flex;align-items:center;gap:12px;margin-bottom:48px}
    .signup-brand .logo-row img{width:36px;height:36px}
    .signup-brand .logo-row span{font-size:1.2rem;font-weight:700;color:#1A1A2E}
    .signup-brand .tag{
      display:inline-block;font-size:.78rem;font-weight:600;color:#F28C38;
      background:rgba(242,140,56,.08);padding:6px 16px;border-radius:100px;margin-bottom:20px;
    }
    .signup-brand h1{font-size:clamp(2.2rem,4vw,3.2rem);font-weight:900;line-height:1.1;letter-spacing:-.04em;margin-bottom:20px}
    .signup-brand h1 .gradient-text{
      background:linear-gradient(135deg,#F28C38 0%,#e07b28 50%,#F28C38 100%);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
    }
    .signup-brand p{font-size:1.05rem;color:#737373;line-height:1.7;max-width:440px}
    .signup-brand .trial-perks{margin-top:32px}
    .signup-brand .trial-perks h3{font-size:.9rem;font-weight:700;color:#1A1A2E;margin-bottom:12px}
    .signup-brand .trial-perks li{
      display:flex;align-items:center;gap:10px;padding:7px 0;
      font-size:.925rem;color:#525252;list-style:none;
    }
    .signup-brand .trial-perks li::before{content:'✓';color:#F28C38;font-weight:700}

    /* Right — Form */
    .signup-form-wrap{display:flex;align-items:center;justify-content:center;padding:48px;background:#fff}
    .signup-card{width:100%;max-width:420px}
    .signup-card h2{font-size:1.5rem;font-weight:800;color:#1A1A2E;margin-bottom:6px}
    .signup-card .subtitle{color:#9CA3AF;font-size:.9rem;margin-bottom:28px}
    .form-group{margin-bottom:16px}
    .form-group label{display:block;margin-bottom:6px;font-weight:600;font-size:.82rem;color:#6B7280}
    .form-group input{
      width:100%;padding:13px 16px;border:1.5px solid #E8DFD0;border-radius:16px;
      font-size:.95rem;color:#1A1A2E;background:#FAF7FF;transition:all .2s;
    }
    .form-group input:focus{outline:none;border-color:#F28C38;box-shadow:0 0 0 3px rgba(242,140,56,.1)}
    .form-group input::placeholder{color:#D1D5DB}
    .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .btn-signup{
      width:100%;padding:14px;margin-top:8px;
      background:linear-gradient(135deg,#F28C38 0%,#e07b28 100%);color:#fff;
      border:none;border-radius:16px;font-size:1rem;font-weight:600;cursor:pointer;
      transition:all .25s;box-shadow:0 4px 16px rgba(242,140,56,.25);
    }
    .btn-signup:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(242,140,56,.3)}
    .btn-signup:disabled{opacity:.5;cursor:not-allowed;transform:none}
    .signup-footer{text-align:center;margin-top:20px;font-size:.85rem;color:#9CA3AF}
    .signup-footer a{color:#F28C38;text-decoration:none;font-weight:600}
    .signup-footer a:hover{text-decoration:underline}
    .trial-note{text-align:center;font-size:.78rem;color:#9CA3AF;margin-top:12px}

    .flash-error{background:#FEE2E2;color:#991B1B;padding:10px 14px;border-radius:14px;font-size:.85rem;margin-bottom:16px;border:1px solid #FECACA}

    @media(max-width:768px){
      .signup-page{grid-template-columns:1fr}
      .signup-brand{display:none}
      .signup-form-wrap{min-height:100vh}
    }
  </style>
</head>
<body>
  <div class="signup-page">
    <!-- Left — Branding -->
    <div class="signup-brand">
      <div class="logo-row">
        <img src="/img/logo.svg" alt="Bookwize">
        <span>Bookwize</span>
      </div>
      <span class="tag">14-day free trial — No credit card required</span>
      <h1>Start booking<br><span class="gradient-text">in 2 minutes.</span></h1>
      <p>Create your free account, set up your services, and share your booking link. It's that simple.</p>
      <div class="trial-perks">
        <h3>Your free trial includes:</h3>
        <ul>
          <li>Online booking page</li>
          <li>1 staff member</li>
          <li>Up to 3 services</li>
          <li>10 bookings per month</li>
          <li>Email notifications</li>
          <li>Customer management</li>
          <li>Full setup wizard</li>
        </ul>
      </div>
    </div>

    <!-- Right — Form -->
    <div class="signup-form-wrap">
      <div class="signup-card">
        <h2>Create your account</h2>
        <p class="subtitle">Free 14-day trial. No credit card needed.</p>
        <%- include('../partials/flash') %>
        <form method="POST" action="/admin/signup">
          <div class="form-group">
            <label>Business Name</label>
            <input type="text" name="business_name" placeholder="e.g. Faded Studio" required>
          </div>
          <div class="field-row">
            <div class="form-group">
              <label>First Name</label>
              <input type="text" name="first_name" placeholder="John" required>
            </div>
            <div class="form-group">
              <label>Last Name</label>
              <input type="text" name="last_name" placeholder="Smith" required>
            </div>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="you@business.com" required>
          </div>
          <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" placeholder="Min 6 characters" required minlength="6">
          </div>
          <button type="submit" class="btn-signup">Start Free Trial</button>
          <p class="trial-note">14 days free. Upgrade anytime. Cancel anytime.</p>
        </form>
        <div class="signup-footer">
          Already have an account? <a href="/admin/login">Log in</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
