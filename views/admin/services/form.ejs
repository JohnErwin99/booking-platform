<div class="form-page">
  <a href="/admin/services" class="back-link">Back to Services</a>

  <form method="POST" action="/admin/services<%= service ? '/' + service.id : '' %>" class="settings-form">
    <div class="form-group">
      <label>Service Name *</label>
      <input type="text" name="name" value="<%= service ? service.name : '' %>" required placeholder="e.g., Haircut">
    </div>

    <div class="form-group">
      <label>Category</label>
      <input type="text" name="category" value="<%= service ? service.category || '' : '' %>" placeholder="e.g., Haircuts, Coloring">
    </div>

    <div class="form-group">
      <label>Description</label>
      <textarea name="description" rows="2"><%= service ? service.description || '' : '' %></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Duration (minutes) *</label>
        <input type="number" name="duration_minutes" value="<%= service ? service.duration_minutes : 30 %>" required min="5" step="5">
      </div>
      <div class="form-group">
        <label>Price ($) *</label>
        <input type="number" name="price" value="<%= service ? (service.price_cents / 100).toFixed(2) : '' %>" required min="0" step="0.01">
      </div>
      <div class="form-group">
        <label>Sort Order</label>
        <input type="number" name="sort_order" value="<%= service ? service.sort_order : 0 %>" min="0">
      </div>
    </div>

    <% if (service) { %>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="is_active" value="1" <%= service.is_active ? 'checked' : '' %>>
          Active (visible on booking page)
        </label>
      </div>
    <% } %>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= service ? 'Update' : 'Add' %> Service</button>
      <a href="/admin/services" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>
