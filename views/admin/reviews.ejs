<div class="toolbar">
  <h2 class="section-title" style="margin:0" data-en="Customer Reviews" data-fr="Avis clients">Customer Reviews</h2>
  <% if (totalReviews > 0) { %>
    <div style="display:flex;align-items:center;gap:12px">
      <span style="font-size:1.5rem;font-weight:700;color:var(--primary,#F28C38)">&#9733; <%= avgRating %></span>
      <span class="text-muted"><%= totalReviews %> review<%= totalReviews !== 1 ? 's' : '' %></span>
    </div>
  <% } %>
</div>

<% if (reviews.length === 0) { %>
  <div class="empty-state">
    <p data-en="No reviews yet. Reviews appear here after customers submit them via email link." data-fr="Aucun avis pour l'instant. Les avis apparaissent ici une fois soumis par les clients.">
      No reviews yet. Reviews appear here after customers submit them via email link.
    </p>
  </div>
<% } else { %>
  <div class="section">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th data-en="Rating" data-fr="Note">Rating</th>
            <th data-en="Customer" data-fr="Client">Customer</th>
            <th data-en="Service / Staff" data-fr="Service / Personnel">Service / Staff</th>
            <th data-en="Comment" data-fr="Commentaire">Comment</th>
            <th data-en="Photo" data-fr="Photo">Photo</th>
            <th data-en="Date" data-fr="Date">Date</th>
            <th data-en="Visibility" data-fr="Visibilité">Visibility</th>
          </tr>
        </thead>
        <tbody>
          <% reviews.forEach(r => { %>
            <tr>
              <td>
                <span style="font-size:1.1rem;color:#F59E0B">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <%= i <= r.rating ? '★' : '☆' %>
                  <% } %>
                </span>
                <span class="text-muted" style="font-size:0.8rem;margin-left:4px"><%= r.rating %>/5</span>
              </td>
              <td>
                <strong><%= r.customer_name %></strong><br>
                <small class="text-muted"><%= r.customer_email %></small>
              </td>
              <td>
                <strong><%= r.service_name %></strong><br>
                <small class="text-muted"><%= r.staff_name %></small>
              </td>
              <td style="max-width:240px">
                <% if (r.comment) { %>
                  <span style="font-size:0.875rem;color:#374151"><%= r.comment.length > 120 ? r.comment.slice(0,120) + '…' : r.comment %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td>
                <% if (r.photo_url) { %>
                  <a href="<%= r.photo_url %>" target="_blank" rel="noopener">
                    <img src="<%= r.photo_url %>" alt="Review photo" style="width:52px;height:52px;object-fit:cover;border-radius:8px;border:1px solid #e2e8f0">
                  </a>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td class="text-muted" style="font-size:0.82rem">
                <%= new Date(r.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
              </td>
              <td>
                <form method="POST" action="/admin/reviews/<%= r.id %>/toggle" style="display:inline">
                  <button type="submit" class="btn btn-sm <%= r.is_public ? 'btn-secondary' : 'btn-ghost' %>" title="<%= r.is_public ? 'Click to hide' : 'Click to make public' %>">
                    <% if (r.is_public) { %>
                      <span data-en="Public" data-fr="Public">Public</span>
                    <% } else { %>
                      <span data-en="Hidden" data-fr="Caché">Hidden</span>
                    <% } %>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
