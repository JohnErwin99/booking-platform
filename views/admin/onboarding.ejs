<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Setup Your Business — Bookwize</title>
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    [x-cloak]{display:none!important}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',system-ui,sans-serif;background:#fff;color:#1A1A2E;min-height:100vh;-webkit-font-smoothing:antialiased}

    .wizard{max-width:520px;margin:0 auto;padding:24px 20px;min-height:100vh;display:flex;flex-direction:column}
    .wizard-header{display:flex;align-items:center;gap:10px;padding:12px 0 24px}
    .wizard-header img{width:28px;height:28px;border-radius:8px}
    .wizard-header span{font-size:1rem;font-weight:700}

    /* Progress */
    .progress{display:flex;gap:6px;margin-bottom:32px}
    .progress-dot{flex:1;height:4px;border-radius:100px;background:#E5E7EB;transition:all .4s}
    .progress-dot.active{background:#1A1A2E}
    .progress-dot.done{background:#1A1A2E}

    /* Steps */
    .step{display:none;animation:fadeUp .3s ease;flex:1}
    .step.active{display:flex;flex-direction:column}
    @keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}

    .step h2{font-size:1.4rem;font-weight:800;margin-bottom:6px;line-height:1.2}
    .step p.desc{color:#9CA3AF;font-size:.88rem;line-height:1.6;margin-bottom:24px}

    /* Form elements */
    .field{margin-bottom:16px}
    .field label{display:block;font-size:.75rem;font-weight:700;color:#9CA3AF;text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px}
    .field input,.field select,.field textarea{
      width:100%;padding:12px 16px;border:1px solid #E5E7EB;border-radius:10px;
      font-size:.9rem;color:#1A1A2E;background:#FAFAFA;
      transition:all .2s;outline:none;font-family:inherit;
    }
    .field input:focus,.field select:focus,.field textarea:focus{border-color:#1A1A2E;box-shadow:0 0 0 3px rgba(26,26,46,.08);background:#fff}
    .field input::placeholder{color:#D1D5DB}
    .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .field input[type="file"]{padding:10px;background:#FAFAFA;cursor:pointer}

    /* Buttons */
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:13px 24px;border-radius:12px;font-size:.9rem;font-weight:700;
      border:none;cursor:pointer;transition:all .2s;font-family:inherit;
    }
    .btn-primary{background:#1A1A2E;color:#fff;width:100%}
    .btn-primary:hover{background:#2A2A44}
    .btn-secondary{background:#fff;color:#1A1A2E;border:1px solid #E5E7EB;width:100%}
    .btn-secondary:hover{border-color:#1A1A2E}
    .btn-ghost{background:none;color:#9CA3AF;font-size:.85rem;padding:10px;transition:color .2s}
    .btn-ghost:hover{color:#1A1A2E}
    .btn-row{display:flex;gap:10px;margin-top:auto;padding-top:24px}
    .btn:disabled{opacity:.5;cursor:not-allowed}

    /* Chips */
    .added-list{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
    .chip{
      display:inline-flex;align-items:center;gap:6px;
      padding:6px 14px;border-radius:100px;font-size:.78rem;font-weight:600;
      background:#F5F3FA;color:#1A1A2E;border:1px solid #E5E7EB;
    }

    /* Form card */
    .form-card{
      background:#FAFAFA;border-radius:14px;padding:20px;
      margin-bottom:16px;border:1px solid #E5E7EB;
    }

    /* Hours grid */
    .hours-grid{display:flex;flex-direction:column;gap:6px}
    .hour-row{
      display:grid;grid-template-columns:70px 1fr 1fr auto;gap:8px;align-items:center;
      padding:10px 14px;background:#FAFAFA;border-radius:10px;border:1px solid #E5E7EB;
    }
    .hour-row label{font-size:.85rem;font-weight:600;color:#1A1A2E}
    .hour-row input[type="time"]{padding:8px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:.85rem;background:#fff;font-family:inherit}
    .hour-toggle{width:40px;height:24px;border-radius:100px;background:#E5E7EB;border:none;cursor:pointer;position:relative;transition:background .3s}
    .hour-toggle.on{background:#1A1A2E}
    .hour-toggle::after{content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:left .3s;box-shadow:0 1px 3px rgba(0,0,0,.1)}
    .hour-toggle.on::after{left:19px}

    /* Success */
    .success-icon{width:72px;height:72px;border-radius:50%;background:#1A1A2E;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:2rem;color:#fff}
    .booking-link{
      display:block;padding:16px;background:#FAFAFA;border-radius:12px;
      text-align:center;font-size:.9rem;font-weight:600;color:#1A1A2E;
      border:1px solid #E5E7EB;margin:20px 0;word-break:break-all;
    }

    /* Service checkbox labels */
    .svc-check{
      display:flex;align-items:center;gap:6px;
      padding:8px 14px;border-radius:10px;border:1px solid #E5E7EB;
      font-size:.82rem;font-weight:500;cursor:pointer;
      background:#fff;transition:all .2s;
    }
    .svc-check:hover{border-color:#1A1A2E}

    /* Location row */
    .loc-row{display:flex;align-items:center;gap:10px;padding:10px 14px;background:#FAFAFA;border-radius:10px;margin-bottom:6px;border:1px solid #E5E7EB}
    .loc-row span.loc-name{flex:1;font-weight:500;font-size:.88rem}

    .status-msg{font-size:.82rem;color:#22C55E;font-weight:600;margin-bottom:12px}

    @media(max-width:480px){
      .field-row{grid-template-columns:1fr}
      .hour-row{grid-template-columns:55px 1fr 1fr auto;gap:4px;padding:8px 10px}
    }
  </style>
</head>
<body>
  <div class="wizard" x-data="onboardingWizard()" x-cloak>
    <div class="wizard-header">
      <img src="/img/logo.svg" alt="Bookwize">
      <span>Bookwize</span>
    </div>

    <!-- Progress bar -->
    <div class="progress">
      <template x-for="i in 5">
        <div class="progress-dot" :class="{ active: step === i, done: step > i }"></div>
      </template>
    </div>

    <!-- Step 1: Business Info -->
    <div class="step" :class="{ active: step === 1 }">
      <h2>Set up your business</h2>
      <p class="desc">Tell us about your business to get started.</p>
      <form @submit.prevent="saveBusiness()" id="businessForm" enctype="multipart/form-data">
        <div class="field">
          <label>Business Name</label>
          <input type="text" x-model="business.name" placeholder="e.g. Faded Studio" required>
        </div>
        <div class="field">
          <label>Logo (optional)</label>
          <input type="file" name="logo" accept="image/*" @change="logoFile = $event.target.files[0]">
        </div>
        <div class="field">
          <label>Phone</label>
          <input type="tel" x-model="business.phone" placeholder="(514) 555-0123">
        </div>
        <div class="field-row">
          <div class="field">
            <label>Timezone</label>
            <select x-model="business.timezone">
              <option value="America/Montreal">Montreal (ET)</option>
              <option value="America/Toronto">Toronto (ET)</option>
              <option value="America/Vancouver">Vancouver (PT)</option>
              <option value="America/Edmonton">Edmonton (MT)</option>
              <option value="America/Winnipeg">Winnipeg (CT)</option>
              <option value="America/New_York">New York (ET)</option>
            </select>
          </div>
          <div class="field">
            <label>Currency</label>
            <select x-model="business.currency">
              <option value="CAD">CAD ($)</option>
              <option value="USD">USD ($)</option>
              <option value="EUR">EUR</option>
              <option value="GBP">GBP</option>
            </select>
          </div>
        </div>

        <!-- Locations -->
        <div style="margin-top:20px;padding-top:20px;border-top:1px solid #E5E7EB">
          <label style="display:block;font-size:.75rem;font-weight:700;color:#9CA3AF;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px">Locations</label>
          <template x-for="loc in locationList" :key="loc.id">
            <div class="loc-row">
              <span>&#128205;</span>
              <span class="loc-name" x-text="loc.name"></span>
              <template x-if="!loc.is_default">
                <button type="button" style="font-size:.72rem;color:#EF4444;background:none;border:none;cursor:pointer;font-weight:600" @click="removeLocation(loc.id)">Remove</button>
              </template>
              <template x-if="loc.is_default">
                <span style="font-size:.7rem;color:#9CA3AF;font-weight:500">Default</span>
              </template>
            </div>
          </template>
          <div style="display:flex;gap:8px;margin-top:8px">
            <input type="text" x-model="newLocationName" placeholder="New location name" style="flex:1;font-size:.85rem">
            <button type="button" class="btn-ghost" @click="addLocation()" :disabled="!newLocationName.trim()" style="font-size:.82rem;white-space:nowrap;font-weight:600">+ Add</button>
          </div>
        </div>

        <div class="btn-row">
          <button type="submit" class="btn btn-primary" :disabled="saving">
            <span x-show="!saving">Continue</span>
            <span x-show="saving">Saving...</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Step 2: Services -->
    <div class="step" :class="{ active: step === 2 }">
      <h2>Add your services</h2>
      <p class="desc">What can clients book? Add at least one service.</p>

      <div class="added-list" x-show="serviceList.length">
        <template x-for="s in serviceList" :key="s.id">
          <div class="chip" x-text="s.name + ' — $' + (s.price_cents/100).toFixed(2)"></div>
        </template>
      </div>

      <div class="form-card">
        <form @submit.prevent="addService()">
          <div class="field">
            <label>Service Name</label>
            <input type="text" x-model="newService.name" placeholder="e.g. Haircut & Beard" required>
          </div>
          <div class="field-row">
            <div class="field">
              <label>Duration (min)</label>
              <input type="number" x-model="newService.duration_minutes" placeholder="30" min="5" step="5">
            </div>
            <div class="field">
              <label>Price ($)</label>
              <input type="number" x-model="newService.price" placeholder="40.00" min="0" step="0.01" required>
            </div>
          </div>
          <div class="field">
            <label>Category (optional)</label>
            <input type="text" x-model="newService.category" placeholder="e.g. Haircuts">
          </div>
          <button type="submit" class="btn btn-secondary" :disabled="saving">
            <span x-show="!saving">Save Service</span>
            <span x-show="saving">Saving...</span>
          </button>
        </form>
      </div>

      <p x-show="serviceList.length" class="status-msg">&#10003; <span x-text="serviceList.length"></span> service(s) added</p>

      <div class="btn-row">
        <button class="btn btn-ghost" @click="step = 1">&larr; Back</button>
        <button class="btn btn-primary" @click="serviceList.length ? step = 3 : (errorMsg = 'Please add at least one service.')" style="flex:1">
          Continue
        </button>
      </div>
    </div>

    <!-- Step 3: Staff -->
    <div class="step" :class="{ active: step === 3 }">
      <h2>Add your team</h2>
      <p class="desc">Who will take bookings? Add at least one team member.</p>

      <div class="added-list" x-show="staffList.length">
        <template x-for="s in staffList" :key="s.id">
          <div class="chip" x-text="s.first_name + ' ' + s.last_name"></div>
        </template>
      </div>

      <div class="form-card">
        <form @submit.prevent="addStaff()">
          <div class="field-row">
            <div class="field">
              <label>First Name</label>
              <input type="text" x-model="newStaff.first_name" placeholder="Steve" required>
            </div>
            <div class="field">
              <label>Last Name</label>
              <input type="text" x-model="newStaff.last_name" placeholder="Martinez" required>
            </div>
          </div>
          <div class="field">
            <label>Email</label>
            <input type="email" x-model="newStaff.email" placeholder="steve@business.com">
          </div>
          <div class="field-row">
            <div class="field">
              <label>Title (optional)</label>
              <input type="text" x-model="newStaff.title" placeholder="e.g. Senior Barber">
            </div>
            <div class="field">
              <label>Role</label>
              <select x-model="newStaff.role">
                <option value="contributor">Contributor</option>
                <option value="owner">Owner</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label>Password (for their login)</label>
            <input type="password" x-model="newStaff.password" placeholder="Min 6 characters" minlength="6">
          </div>
          <div class="field" x-show="serviceList.length">
            <label>Assign Services</label>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px">
              <template x-for="svc in serviceList" :key="svc.id">
                <label class="svc-check">
                  <input type="checkbox" :value="svc.id" x-model="newStaff.service_ids" style="accent-color:#1A1A2E">
                  <span x-text="svc.name"></span>
                </label>
              </template>
            </div>
          </div>
          <button type="submit" class="btn btn-secondary" :disabled="saving">
            <span x-show="!saving">Save Staff Member</span>
            <span x-show="saving">Saving...</span>
          </button>
        </form>
      </div>

      <p x-show="staffList.length" class="status-msg">&#10003; <span x-text="staffList.length"></span> staff member(s) added</p>

      <div class="btn-row">
        <button class="btn btn-ghost" @click="step = 2">&larr; Back</button>
        <button class="btn btn-primary" @click="staffList.length ? step = 4 : (errorMsg = 'Please add at least one staff member.')" style="flex:1">
          Continue
        </button>
      </div>
    </div>

    <!-- Step 4: Hours -->
    <div class="step" :class="{ active: step === 4 }">
      <h2>Set your hours</h2>
      <p class="desc">When are you open for business? Toggle off days you're closed.</p>

      <div class="hours-grid">
        <template x-for="(day, i) in dayNames" :key="i">
          <div class="hour-row">
            <label x-text="day.slice(0,3)"></label>
            <template x-if="!hours[i].closed">
              <input type="time" x-model="hours[i].open_at">
            </template>
            <template x-if="!hours[i].closed">
              <input type="time" x-model="hours[i].close_at">
            </template>
            <template x-if="hours[i].closed">
              <span style="grid-column:span 2;color:#9CA3AF;font-size:.85rem;text-align:center">Closed</span>
            </template>
            <button type="button" class="hour-toggle" :class="{ on: !hours[i].closed }"
              @click="hours[i].closed = !hours[i].closed"></button>
          </div>
        </template>
      </div>

      <div class="btn-row">
        <button class="btn btn-ghost" @click="step = 3">&larr; Back</button>
        <button class="btn btn-primary" @click="saveHours()" :disabled="saving" style="flex:1">
          <span x-show="!saving">Finish Setup</span>
          <span x-show="saving">Saving...</span>
        </button>
      </div>
    </div>

    <!-- Step 5: Done -->
    <div class="step" :class="{ active: step === 5 }" style="text-align:center;justify-content:center">
      <div class="success-icon">&#10003;</div>
      <h2>You're all set!</h2>
      <p class="desc" style="margin-bottom:16px">Your booking page is live and ready for clients.</p>
      <div class="booking-link"><%= (process.env.BASE_URL || 'https://bookwizeapp.com') %>/book/<%= tenant.slug %></div>
      <a href="/admin/bookings" class="btn btn-primary" style="text-decoration:none;margin-bottom:12px">Go to Calendar</a>
      <a href="/book/<%= tenant.slug %>" class="btn btn-ghost" target="_blank">Preview Booking Page &rarr;</a>
    </div>

    <!-- Error toast -->
    <div x-show="errorMsg" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#1A1A2E;color:#fff;padding:12px 28px;border-radius:12px;font-size:.85rem;font-weight:600;z-index:9999;box-shadow:0 8px 24px rgba(0,0,0,.15)" x-transition @click="errorMsg=''">
      <span x-text="errorMsg"></span>
    </div>
  </div>

  <script>
    function onboardingWizard() {
      return {
        step: 1,
        saving: false,
        errorMsg: '',
        dayNames: ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],

        business: {
          name: '<%= tenant.name %>',
          phone: '<%= tenant.phone || "" %>',
          timezone: '<%= tenant.timezone || "America/Montreal" %>',
          currency: '<%= tenant.currency || "CAD" %>',
        },
        logoFile: null,

        locationList: <%- JSON.stringify((locations || []).map(l => ({ id: l.id, name: l.name, is_default: l.is_default }))) %>,
        newLocationName: '',

        staffList: <%- JSON.stringify((staff || []).map(s => ({ id: s.id, first_name: s.first_name, last_name: s.last_name }))) %>,
        newStaff: { first_name: '', last_name: '', email: '', title: '', role: 'contributor', password: '', service_ids: [] },

        serviceList: <%- JSON.stringify((services || []).map(s => ({ id: s.id, name: s.name, price_cents: s.price_cents }))) %>,
        newService: { name: '', duration_minutes: '30', price: '', category: '' },

        hours: {
          0: { open_at: '10:00', close_at: '17:00', closed: true },
          1: { open_at: '09:00', close_at: '18:00', closed: false },
          2: { open_at: '09:00', close_at: '18:00', closed: false },
          3: { open_at: '09:00', close_at: '18:00', closed: false },
          4: { open_at: '09:00', close_at: '18:00', closed: false },
          5: { open_at: '09:00', close_at: '18:00', closed: false },
          6: { open_at: '09:00', close_at: '17:00', closed: false },
        },

        async addLocation() {
          if (!this.newLocationName.trim()) return;
          try {
            const res = await fetch('/admin/onboarding/location', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name: this.newLocationName.trim() })
            });
            const data = await res.json();
            if (data.success) {
              this.locationList = data.locations.map(l => ({ id: l.id, name: l.name, is_default: l.is_default }));
              this.newLocationName = '';
            } else { this.errorMsg = data.error || 'Failed to add location.'; }
          } catch (e) { this.errorMsg = 'Connection error.'; }
        },

        async removeLocation(id) {
          try {
            const res = await fetch('/admin/onboarding/location/' + id + '/delete', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
              this.locationList = data.locations.map(l => ({ id: l.id, name: l.name, is_default: l.is_default }));
            } else { this.errorMsg = data.error || 'Cannot remove.'; }
          } catch (e) { this.errorMsg = 'Connection error.'; }
        },

        async saveBusiness() {
          this.saving = true;
          try {
            const form = new FormData();
            form.append('name', this.business.name);
            form.append('phone', this.business.phone);
            form.append('timezone', this.business.timezone);
            form.append('currency', this.business.currency);
            if (this.logoFile) form.append('logo', this.logoFile);

            const res = await fetch('/admin/onboarding/business', { method: 'POST', body: form });
            const data = await res.json();
            if (data.success) this.step = 2;
            else this.errorMsg = data.error || 'Failed to save.';
          } catch (e) { this.errorMsg = 'Connection error.'; }
          this.saving = false;
        },

        async addStaff() {
          if (!this.newStaff.first_name || !this.newStaff.last_name) return;
          this.saving = true;
          try {
            const res = await fetch('/admin/onboarding/staff', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(this.newStaff)
            });
            const data = await res.json();
            if (data.success) {
              this.staffList = data.staff.map(s => ({ id: s.id, first_name: s.first_name, last_name: s.last_name }));
              this.newStaff = { first_name: '', last_name: '', email: '', title: '', role: 'contributor', password: '', service_ids: [] };
            } else { this.errorMsg = data.error || 'Failed to add.'; }
          } catch (e) { this.errorMsg = 'Connection error.'; }
          this.saving = false;
        },

        async addService() {
          if (!this.newService.name || !this.newService.price) return;
          this.saving = true;
          try {
            const res = await fetch('/admin/onboarding/service', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(this.newService)
            });
            const data = await res.json();
            if (data.success) {
              this.serviceList = data.services.map(s => ({ id: s.id, name: s.name, price_cents: s.price_cents }));
              this.newService = { name: '', duration_minutes: '30', price: '', category: '' };
            } else { this.errorMsg = data.error || 'Failed to add.'; }
          } catch (e) { this.errorMsg = 'Connection error.'; }
          this.saving = false;
        },

        async saveHours() {
          this.saving = true;
          try {
            const res = await fetch('/admin/onboarding/hours', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ hours: this.hours })
            });
            const data = await res.json();
            if (data.success) {
              await fetch('/admin/onboarding/complete', { method: 'POST' });
              this.step = 5;
            } else { this.errorMsg = data.error || 'Failed to save.'; }
          } catch (e) { this.errorMsg = 'Connection error.'; }
          this.saving = false;
        }
      };
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js" defer></script>
</body>
</html>
