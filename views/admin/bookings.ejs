<div class="toolbar">
  <form method="GET" action="/admin/bookings" class="filters-form">
    <input type="date" name="from" value="<%= filters.from || '' %>" placeholder="From">
    <input type="date" name="to" value="<%= filters.to || '' %>" placeholder="To">
    <select name="staff_id">
      <option value="" data-en="All Staff" data-fr="Tout le personnel">All Staff</option>
      <% staffList.forEach(s => { %>
        <option value="<%= s.id %>" <%= filters.staff_id == s.id ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %></option>
      <% }) %>
    </select>
    <select name="status">
      <option value="" data-en="All Status" data-fr="Tous les statuts">All Status</option>
      <option value="confirmed" <%= filters.status === 'confirmed' ? 'selected' : '' %> data-en="Confirmed" data-fr="Confirmé">Confirmed</option>
      <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %> data-en="Completed" data-fr="Terminé">Completed</option>
      <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %> data-en="Cancelled" data-fr="Annulé">Cancelled</option>
      <option value="no_show" <%= filters.status === 'no_show' ? 'selected' : '' %> data-en="No Show" data-fr="Absence">No Show</option>
    </select>
    <% if (locations && locations.length > 1) { %>
    <select name="location_id">
      <option value="" data-en="All Locations" data-fr="Tous les emplacements">All Locations</option>
      <% locations.forEach(loc => { %>
        <option value="<%= loc.id %>" <%= filters.location_id == loc.id ? 'selected' : '' %>><%= loc.name %></option>
      <% }) %>
    </select>
    <% } %>
    <button type="submit" class="btn btn-secondary" data-en="Filter" data-fr="Filtrer">Filter</button>
    <a href="/admin/bookings" class="btn btn-ghost" data-en="Clear" data-fr="Effacer">Clear</a>
  </form>
  <div class="view-toggle">
    <button class="btn btn-sm" id="listViewBtn" onclick="switchView('list')" data-en="List" data-fr="Liste">List</button>
    <button class="btn btn-sm" id="calendarViewBtn" onclick="switchView('calendar')" data-en="Calendar" data-fr="Calendrier">Calendar</button>
  </div>
</div>

<!-- List View -->
<div id="listView" style="<%= viewMode === 'calendar' ? 'display:none' : '' %>">
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th data-en="Date" data-fr="Date">Date</th>
          <th data-en="Time" data-fr="Heure">Time</th>
          <th data-en="Customer" data-fr="Client">Customer</th>
          <th data-en="Service" data-fr="Service">Service</th>
          <th data-en="Staff" data-fr="Personnel">Staff</th>
          <th data-en="Status" data-fr="Statut">Status</th>
          <% if (calendarConnected) { %><th data-en="Sync" data-fr="Sync">Sync</th><% } %>
          <th data-en="Actions" data-fr="Actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (bookings.length === 0) { %>
          <tr><td colspan="<%= calendarConnected ? 8 : 7 %>" class="text-center" data-en="No bookings found." data-fr="Aucune réservation trouvée.">No bookings found.</td></tr>
        <% } %>
        <% bookings.forEach(b => { %>
          <tr>
            <td><%= new Date(b.booking_date + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit', year: 'numeric' }) %></td>
            <td><%= helpers.formatTimeLabel(b.start_time) %></td>
            <td>
              <strong><%= b.customer_name %></strong>
              <br><small class="text-muted"><%= b.customer_email %></small>
            </td>
            <td><%= b.service_name %></td>
            <td><%= b.staff_name %></td>
            <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
            <% if (calendarConnected) { %>
            <td>
              <% if (b.status === 'cancelled') { %>
                <span class="sync-badge sync-na" title="Cancelled">—</span>
              <% } else if (b.google_event_id) { %>
                <span class="sync-badge sync-yes" title="Synced to Google Calendar">&#10003;</span>
              <% } else { %>
                <span class="sync-badge sync-no" title="Not synced">&#10005;</span>
              <% } %>
            </td>
            <% } %>
            <td class="actions">
              <% if (b.status === 'confirmed') { %>
                <form method="POST" action="/admin/bookings/<%= b.id %>/complete" style="display:inline">
                  <button type="submit" class="btn btn-sm btn-success" title="Mark complete" data-en="Done" data-fr="Terminé">Done</button>
                </form>
                <form method="POST" action="/admin/bookings/<%= b.id %>/cancel" style="display:inline">
                  <button type="submit" class="btn btn-sm btn-danger" title="Cancel" onclick="return confirm(adminLang==='fr'?'Annuler cette réservation?':'Cancel this booking?')" data-en="Cancel" data-fr="Annuler">Cancel</button>
                </form>
                <form method="POST" action="/admin/bookings/<%= b.id %>/no-show" style="display:inline">
                  <button type="submit" class="btn btn-sm btn-warning" title="No show" data-en="No Show" data-fr="Absence">No Show</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Calendar View -->
<div id="calendarView" style="<%= viewMode === 'calendar' ? '' : 'display:none' %>">
  <div class="calendar-date-header">
    <div class="calendar-date-top">
      <button class="strip-nav" onclick="navigateWeek(-1)">&#8249;</button>
      <span class="month-label" id="monthLabel"></span>
      <button class="strip-nav" onclick="navigateWeek(1)">&#8250;</button>
      <button class="btn btn-sm btn-ghost today-btn" onclick="goToday()" data-en="Today" data-fr="Aujourd'hui">Today</button>
    </div>
    <div class="date-days" id="dateDays"></div>
    <div class="cal-view-toggle">
      <button class="cal-view-btn active" id="cvDay" onclick="switchCalView('timeGridDay')" data-en="Day" data-fr="Jour">Day</button>
      <button class="cal-view-btn" id="cvWeek" onclick="switchCalView('timeGridWeek')" data-en="Week" data-fr="Semaine">Week</button>
      <button class="cal-view-btn" id="cvMonth" onclick="switchCalView('dayGridMonth')" data-en="Month" data-fr="Mois">Month</button>
    </div>
  </div>
  <div id="calendar"></div>
</div>

<!-- Event Detail Modal -->
<div id="eventModal" style="display:none">
  <div class="modal-overlay" onclick="closeModal()">
    <div class="modal-card" onclick="event.stopPropagation()">
      <button class="modal-close" onclick="closeModal()">&times;</button>
      <h3 id="modalTitle"></h3>
      <div class="modal-body">
        <div class="modal-row"><span data-en="Customer" data-fr="Client">Customer</span><span id="modalCustomer"></span></div>
        <div class="modal-row"><span data-en="Service" data-fr="Service">Service</span><span id="modalService"></span></div>
        <div class="modal-row"><span data-en="Staff" data-fr="Personnel">Staff</span><span id="modalStaff"></span></div>
        <div class="modal-row"><span data-en="Time" data-fr="Heure">Time</span><span id="modalTime"></span></div>
        <div class="modal-row"><span data-en="Status" data-fr="Statut">Status</span><span id="modalStatus"></span></div>
      </div>
    </div>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.js"></script>

<style>
  .view-toggle{display:flex;gap:4px;background:rgba(232,223,208,.35);border-radius:10px;padding:3px}
  .view-toggle .btn{border:none;border-radius:8px;padding:6px 16px;font-size:.82rem;font-weight:600;background:transparent;color:#6B7280;cursor:pointer}
  .view-toggle .btn.active{background:#fff;color:#1A1A2E;box-shadow:0 1px 4px rgba(0,0,0,.08)}
  .toolbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}

  .calendar-date-header{background:#fff;border-radius:12px;padding:16px 20px;box-shadow:0 2px 12px rgba(0,0,0,.04);margin-bottom:8px}
  .calendar-date-top{display:flex;align-items:center;gap:4px;margin-bottom:14px}
  .month-label{font-size:1.15rem;font-weight:700;color:#1A1A2E;min-width:160px}
  .strip-nav{background:none;border:none;font-size:1.4rem;color:#6B7280;cursor:pointer;padding:4px 10px;border-radius:8px;line-height:1}
  .strip-nav:hover{background:#F3F4F6}
  .today-btn{margin-left:auto!important;font-size:.8rem}
  .date-days{display:flex;gap:4px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:2px}
  .date-days::-webkit-scrollbar{display:none}
  .date-day{display:flex;flex-direction:column;align-items:center;padding:6px 0;border-radius:12px;border:none;background:transparent;cursor:pointer;flex:1 0 auto;min-width:46px;transition:background .15s}
  .date-day:hover{background:#F3F4F6}
  .date-day .day-label{font-size:.7rem;font-weight:600;color:#9CA3AF;text-transform:uppercase;margin-bottom:4px}
  .date-day .day-num{font-size:.95rem;font-weight:700;color:#1A1A2E;width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:50%;transition:all .15s}
  .date-day.today .day-num{background:#F28C38;color:#fff}
  .date-day.selected .day-num{background:#1A1A2E;color:#fff}
  .date-day.selected.today .day-num{background:#1A1A2E;color:#fff}

  .cal-view-toggle{display:flex;gap:4px;margin-top:12px;background:rgba(232,223,208,.35);border-radius:10px;padding:3px}
  .cal-view-btn{border:none;border-radius:8px;padding:6px 16px;font-size:.78rem;font-weight:600;background:transparent;color:#6B7280;cursor:pointer;flex:1;transition:all .15s}
  .cal-view-btn:hover{color:#1A1A2E}
  .cal-view-btn.active{background:#fff;color:#1A1A2E;box-shadow:0 1px 4px rgba(0,0,0,.08)}

  #calendar{background:#fff;border-radius:12px;padding:20px;box-shadow:0 2px 12px rgba(0,0,0,.04)}
  .fc .fc-event{border-radius:6px;padding:2px 6px;font-size:.75rem;border:none;cursor:pointer}
  .fc .fc-timegrid-slot{height:48px}
  .fc .fc-col-header-cell-cushion{font-size:.8rem;font-weight:600;color:#6B7280;text-transform:uppercase}
  .fc .fc-daygrid-day-number{font-size:.85rem;color:#1A1A2E;font-weight:500}

  .modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.4);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:9999}
  .modal-card{background:#fff;border-radius:16px;padding:28px;max-width:400px;width:90%;position:relative;box-shadow:0 24px 64px rgba(0,0,0,.15)}
  .modal-close{position:absolute;top:12px;right:14px;border:none;background:none;font-size:1.4rem;color:#9CA3AF;cursor:pointer}
  .modal-card h3{font-size:1.1rem;font-weight:700;color:#1A1A2E;margin-bottom:16px;padding-right:24px}
  .modal-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #F3F4F6;font-size:.9rem}
  .modal-row span:first-child{color:#9CA3AF;font-weight:500}
  .modal-row span:last-child{color:#1A1A2E;font-weight:600}

  .sync-badge{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;font-size:.8rem;font-weight:700}
  .sync-yes{background:#D1FAE5;color:#059669}
  .sync-no{background:#FEE2E2;color:#DC2626}
  .sync-na{background:#F3F4F6;color:#9CA3AF}
</style>

<script>
  let currentView = '<%= viewMode %>';
  let calendar;
  let selectedDate = new Date();
  let weekStart = getMonday(selectedDate);

  function getMonday(d) {
    const date = new Date(d);
    const day = date.getDay();
    date.setDate(date.getDate() - day + (day === 0 ? -6 : 1));
    date.setHours(0,0,0,0);
    return date;
  }

  function renderDateStrip() {
    const container = document.getElementById('dateDays');
    if (!container) return;
    const dayLabels = (typeof adminLang !== 'undefined' && adminLang === 'fr')
      ? ['L','M','M','J','V','S','D']
      : ['M','T','W','T','F','S','S'];
    container.innerHTML = '';
    const today = new Date(); today.setHours(0,0,0,0);
    const sel = new Date(selectedDate); sel.setHours(0,0,0,0);

    for (let i = 0; i < 7; i++) {
      const d = new Date(weekStart);
      d.setDate(d.getDate() + i);
      d.setHours(0,0,0,0);
      const isSelected = d.getTime() === sel.getTime();
      const isToday = d.getTime() === today.getTime();
      const btn = document.createElement('button');
      btn.className = 'date-day' + (isSelected ? ' selected' : '') + (isToday ? ' today' : '');
      btn.innerHTML = '<span class="day-label">' + dayLabels[i] + '</span><span class="day-num">' + d.getDate() + '</span>';
      (function(dateRef) {
        btn.onclick = function() {
          selectedDate = dateRef;
          renderDateStrip();
          if (calendar) calendar.gotoDate(dateRef);
        };
      })(new Date(d));
      container.appendChild(btn);
    }

    const monthNames = (typeof adminLang !== 'undefined' && adminLang === 'fr')
      ? ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre']
      : ['January','February','March','April','May','June','July','August','September','October','November','December'];
    var ml = document.getElementById('monthLabel');
    if (ml) ml.textContent = monthNames[selectedDate.getMonth()] + ' ' + selectedDate.getFullYear();
  }

  function navigateWeek(dir) {
    weekStart.setDate(weekStart.getDate() + (dir * 7));
    selectedDate = new Date(weekStart);
    renderDateStrip();
    if (calendar) calendar.gotoDate(selectedDate);
  }

  function goToday() {
    selectedDate = new Date();
    weekStart = getMonday(selectedDate);
    renderDateStrip();
    if (calendar) calendar.gotoDate(selectedDate);
  }

  function switchCalView(view) {
    document.getElementById('cvDay').classList.toggle('active', view === 'timeGridDay');
    document.getElementById('cvWeek').classList.toggle('active', view === 'timeGridWeek');
    document.getElementById('cvMonth').classList.toggle('active', view === 'dayGridMonth');
    if (calendar) {
      calendar.changeView(view);
      if (view === 'timeGridDay') calendar.gotoDate(selectedDate);
    }
  }

  function switchView(view) {
    currentView = view;
    document.getElementById('listView').style.display = view === 'list' ? '' : 'none';
    document.getElementById('calendarView').style.display = view === 'calendar' ? '' : 'none';
    document.getElementById('listViewBtn').classList.toggle('active', view === 'list');
    document.getElementById('calendarViewBtn').classList.toggle('active', view === 'calendar');

    if (view === 'calendar' && !calendar) {
      initCalendar();
    }
    if (calendar) calendar.updateSize();
  }

  function initCalendar() {
    const calendarEl = document.getElementById('calendar');
    calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'timeGridDay',
      initialDate: selectedDate,
      locale: (typeof adminLang !== 'undefined' && adminLang === 'fr') ? 'fr' : 'en',
      headerToolbar: false,
      slotMinTime: '07:00:00',
      slotMaxTime: '22:00:00',
      allDaySlot: false,
      height: 'auto',
      nowIndicator: true,
      dayHeaders: false,
      events: function(info, successCallback, failureCallback) {
        var apiUrl = '/admin/bookings/api?start=' + info.startStr.split('T')[0] + '&end=' + info.endStr.split('T')[0];
        var staffFilter = document.querySelector('select[name="staff_id"]');
        if (staffFilter && staffFilter.value) apiUrl += '&staff_id=' + staffFilter.value;
        fetch(apiUrl)
          .then(function(r) { return r.json(); })
          .then(function(data) { successCallback(data); })
          .catch(function(err) { failureCallback(err); });
      },
      eventClick: function(info) {
        var e = info.event;
        var props = e.extendedProps;
        var parts = e.title.split(' - ');
        document.getElementById('modalTitle').textContent = e.title;
        document.getElementById('modalCustomer').textContent = parts[0] || '';
        document.getElementById('modalService').textContent = parts[1] || '';
        document.getElementById('modalStaff').textContent = props.staffName || '';
        var start = e.start ? e.start.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : '';
        var end = e.end ? e.end.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : '';
        document.getElementById('modalTime').textContent = start + ' - ' + end;
        document.getElementById('modalStatus').textContent = props.status || '';
        document.getElementById('eventModal').style.display = '';
      }
    });
    calendar.render();
    renderDateStrip();
  }

  function closeModal() {
    document.getElementById('eventModal').style.display = 'none';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
  });

  // Apply default view
  switchView(currentView);
</script>
