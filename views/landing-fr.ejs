      "highPrice": "599",
      "offerCount": "4"
    }
  }
  </script>

  <!-- JSON-LD: FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Quel est le meilleur système de réservation en ligne pour les salons et barbiers au Canada?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bookwize est une plateforme de réservation en ligne et CRM tout-en-un conçue pour les salons, barbiers, spas et entreprises de services à Montréal et partout au Canada. Elle offre la réservation 24/7, la gestion du personnel, les rappels par courriel automatiques, la marque blanche et des widgets intégrables. Les forfaits commencent à 19$/mois ou 299$ en paiement unique."
        }
      },
      {
        "@type": "Question",
        "name": "Comment fonctionne la réservation en ligne avec Bookwize?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Les clients visitent votre page de réservation Bookwize personnalisée, choisissent un service et un membre du personnel, sélectionnent une date et une heure disponibles, et confirment leur rendez-vous. Vous recevez une notification instantanée et le client reçoit une confirmation par courriel avec une invitation au calendrier."
        }
